# Скопируйте этот файл в .env и заполните значения.
# .env в git не попадает (см. корневой .gitignore).

# Токен вашего бота от @BotFather (проверка подписи Telegram + пуш-уведомления
# + оплата Premium через Telegram Stars).
BOT_TOKEN=

# Секрет вебхука Telegram (/telegram/webhook) — принимает pre_checkout_query
# и successful_payment для оплаты Premium. Задайте своё случайное значение
# и передайте его же в secret_token при вызове setWebhook у Telegram, чтобы
# на вебхук не мог постучаться кто угодно. Без публичного HTTPS-адреса
# (deploy, а не localhost) вебхук всё равно не заработает — Stars-оплата
# локально не тестируется, только через grant-premium.js.
TELEGRAM_WEBHOOK_SECRET=

# https-адрес мини-приложения. Если задан, к пуш-уведомлениям добавляется
# кнопка, открывающая приложение. Необязательно.
MINI_APP_URL=

# Порт API-сервера.
PORT=3001

# Куда писать БД (data.db) и загруженные файлы (uploads/, verification-uploads/).
# По умолчанию — папка backend/, этого достаточно локально. На проде указывайте
# путь, где смонтирован постоянный диск (persistent volume), иначе всё это
# исчезнет при следующем деплое/перезапуске.
DATA_DIR=

# Разрешить "фейковый" вход без Telegram — ТОЛЬКО для локальной разработки.
# Фронтенд в dev-режиме шлёт заголовок X-Dev-User: <id>, и сервер верит ему.
# На проде обязательно false (или убрать строку).
ALLOW_DEV_AUTH=true

# Откуда фронтенду можно обращаться к API (CORS). * — с любого адреса (только для dev).
CORS_ORIGIN=*

# Аварийный список id администраторов через запятую. Обычно пусто:
# права модератора хранятся в базе (users.is_admin) и выдаются скриптом
#   npm run grant-admin <telegram-id>
# Заполняйте эту строку, только если нужен гарантированный доступ (первый
# админ, отладка). Пустое значение = обычный пользователь модерацию не видит.
ADMIN_IDS=
